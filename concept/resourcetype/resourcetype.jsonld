        "@value": "2026-11-24"
      }
    ],
    "http://purl.org/dc/terms/description": [
      {
        "@language": "de",
        "@value": "Typen von Ressourcen im DZG-Metadatenmodell, die über dcterms:type an dcat:Dataset unterschieden werden."
      },
      {
        "@language": "en",
        "@value": "Types of resources in the DZG metadata model that are distinguished by dcterms:type on dcat:Dataset."
      }
    ],
    "http://purl.org/dc/terms/title": [
      {
        "@language": "de",
        "@value": "Ressourcentyp"
      },
      {
        "@language": "en",
        "@value": "Resource type"
      }
    ],
    "http://www.w3.org/2002/07/owl#versionInfo": [
      {
        "@value": "0.1"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#hasTopConcept": [
      {
        "@id": "http://dcat-ap.at/concept/resourcetype/Dataproduct"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "de",
        "@value": "Ressourcentyp"
      },
      {
        "@language": "en",
        "@value": "Resource type"
      }
    ]
  },
  {
    "@id": "http://dcat-ap.at/concept/resourcetype/Dataproduct",
    "@type": [
      "http://www.w3.org/2004/02/skos/core#Concept"
    ],
    "http://www.w3.org/2004/02/skos/core#definition": [
      {
        "@language": "de",
        "@value": "Fachlich zusammengehörige Datensätze und Datensatzserien einer öffentlichen Stelle, zusammen mit der Beschreibung ihrer Entstehung (Erhebungsform, Datenquellen, Grundgesamtheit, Rechtsgrundlagen). Ein Datenprodukt hat selbst keine Distributionen; seine Bestandteile verweisen mit dcterms:isPartOf auf es."
      },
      {
        "@language": "en",
        "@value": "Datasets and dataset series of a public body that belong together, with a description of how they are produced (survey method, data sources, population, legal basis). A data product has no distributions of its own; its members refer to it with dcterms:isPartOf."
      }
    ],
    "http://www.w3.org/2004/02/skos/core#inScheme": [
      {
        "@id": "http://dcat-ap.at/concept/resourcetype/"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#notation": [
      {
        "@value": "Dataproduct"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#prefLabel": [
      {
        "@language": "de",
        "@value": "Datenprodukt"
      },
      {
        "@language": "en",
        "@value": "Data product"
      }
    ],
    "http://www.w3.org/2004/02/skos/core#topConceptOf": [
      {
        "@id": "http://dcat-ap.at/concept/resourcetype/"
      }
    ]
  }
]